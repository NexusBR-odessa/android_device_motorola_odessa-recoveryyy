# This file is used by TWRP and PBRP to mount partitions.
# See https://source.android.com/devices/tech/ota/dynamic_partitions/implement#flashable-recovery for more info.

# Mountpoint        FSType    Device                                                  Flags

# Dynamic Partitions (Android 10+)
/dev/block/by-name/super        /super        emmc    flags=display="Super",backup=0,wipeafter=0,noemulatefs,can_be_mounted,wrapped,readonly
/system                     ext4    system                                                  flags=display="System",logical,slotselect
/vendor                     ext4    vendor                                                  flags=display="Vendor",logical,slotselect
/product                    ext4    product                                                 flags=display="Product",logical,slotselect
/system_ext                 ext4    system_ext                                              flags=display="System Ext",logical,slotselect
/odm                        ext4    odm                                                     flags=display="ODM",logical,slotselect

# Physical Partitions
/data                       ext4    /dev/block/bootdevice/by-name/userdata                  flags=display="Data",encryptable=footer
/boot                       emmc    /dev/block/bootdevice/by-name/boot_a                    flags=display="Boot",backup=1;flashimg;slotselect
/recovery                   emmc    /dev/block/bootdevice/by-name/recovery_a                flags=display="Recovery",backup=1;flashimg;slotselect
/dtbo                       emmc    /dev/block/bootdevice/by-name/dtbo_a                    flags=display="DTBO",backup=1;flashimg;slotselect
/misc                       emmc    /dev/block/bootdevice/by-name/misc                      flags=display="Misc"
/metadata                   emmc    /dev/block/bootdevice/by-name/metadata                  flags=display="Metadata",backup=0,wipeafter=0
/splash                     emmc    /dev/block/bootdevice/by-name/logo_a                    flags=display="Splash"

# Internal Storage (if applicable, remove if /data covers all internal storage)
# This device list doesn't show a separate internal storage other than /data,
# so we assume /data handles internal storage.

# External Storage (Micro SDcard, confirm block device path if different)
/external_sd                auto    /dev/block/mmcblk0p1                                    flags=display="Micro SDcard";storage;wipeingui;removable
/external_sd                auto    /dev/block/mmcblk1p1                                    flags=display="Micro SDcard";storage;wipeingui;removable

# USB OTG (confirm block device path if different)
/usb_otg                    auto    /dev/block/sda1                                         flags=display="USB OTG";storage;wipeingui;removable
/usb_otg                    auto    /dev/block/sdb1                                         flags=display="USB OTG";storage;wipeingui;removable
